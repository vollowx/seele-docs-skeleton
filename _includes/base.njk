<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title or "seele docs" }}</title>
    <link href="/client/main.css" rel="stylesheet" />
    <script type="module" src="/client/lit-hydrate-support.js"></script>
    <script type="module" src="/client/main.js"></script>
    {% if components %}
      {% for component in components %}
    <script type="module" src="/client/{{ component }}.js"></script>
      {% endfor %}
    {% endif %}

    <style> body[dsd-pending] { display: none; } </style>
    <noscript>
      <style> body[dsd-pending] { display: block !important; } </style>
    </noscript>
  </head>
  <body dsd-pending>
    <main>
      {{ content | safe }}
    </main>

    <footer>
      <md-divider></md-divider>
      <p>
        Copyright © 2023-2026 by Lucas X. Zhao.<br />
        Last built at {{ buildTime.formatted }} with Eleventy {{ eleventy.version }}.
      </p>
      <md-divider></md-divider>
    </footer>

    <nav>
      <h2>Entries</h2>
      <ul>
        {%- for item in collections.all %}
          <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.url }}</a></li>
        {%- endfor %}
      </ul>
    </nav>

    <script>
      (function() {
        if (!HTMLTemplateElement.prototype.hasOwnProperty('shadowRootMode')) {
          (function attachShadowRoots(root) {
            root.querySelectorAll("template[shadowrootmode]").forEach(template => {
              const mode = template.getAttribute("shadowrootmode");
              const shadowRoot = template.parentNode.attachShadow({ mode });
              shadowRoot.appendChild(template.content);
              template.remove();
              attachShadowRoots(shadowRoot);
            });
          })(document);
        }
        document.body.removeAttribute('dsd-pending');
      })();
    </script>
  </body>
</html>
